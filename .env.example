# Copy this file to `.env` and paste your Roboflow API key below.
#
#     cp .env.example .env
#
# Find your key in the Roboflow dashboard under Account > Roboflow Keys.
# Then check it works:
#
#     uv run python api_key.py
#
# `.env` is listed in .gitignore and must stay there. Never commit your key.
# A key pushed to a public fork is a key you have to revoke.

ROBOFLOW_API_KEY=paste-your-key-here
